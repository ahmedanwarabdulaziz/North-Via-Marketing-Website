{
  "name": "Google Reviews – auto check & draft",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "a1f0c6c2-6d1e-4c38-9a51-1b2f0f6a0001",
      "name": "Every 30 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://www.northviamarketing.com/api/reviews/sync",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 70000
        }
      },
      "id": "a1f0c6c2-6d1e-4c38-9a51-1b2f0f6a0002",
      "name": "Check reviews & draft replies",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "NVM Reviews API"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "a1f0c6c2-6d1e-4c38-9a51-1b2f0f6a0010",
              "leftValue": "={{ $json.summary.draftsCreated }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1f0c6c2-6d1e-4c38-9a51-1b2f0f6a0003",
      "name": "New drafts?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1f0c6c2-6d1e-4c38-9a51-1b2f0f6a0020",
              "name": "message",
              "value": "=⭐ {{ $json.summary.draftsCreated }} new review repl{{ $json.summary.draftsCreated === 1 ? 'y' : 'ies' }} drafted.\n5★ ready for bulk approval: {{ $json.summary.awaitingApproval.fiveStar }}\n4★ & below to check one by one: {{ $json.summary.awaitingApproval.needsReview }}\nhttps://www.northviamarketing.com/admin/reviews",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1f0c6c2-6d1e-4c38-9a51-1b2f0f6a0004",
      "name": "Build notification (connect Telegram next)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [720, -100]
    }
  ],
  "connections": {
    "Every 30 minutes": {
      "main": [[{ "node": "Check reviews & draft replies", "type": "main", "index": 0 }]]
    },
    "Check reviews & draft replies": {
      "main": [[{ "node": "New drafts?", "type": "main", "index": 0 }]]
    },
    "New drafts?": {
      "main": [[{ "node": "Build notification (connect Telegram next)", "type": "main", "index": 0 }], []]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Toronto"
  },
  "active": false
}
