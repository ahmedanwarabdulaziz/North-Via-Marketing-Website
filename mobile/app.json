{
  "expo": {
    "name": "Anwarz",
    "slug": "anwarz",
    "version": "0.9.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "anwarz",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.northviamarketing.anwarz"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#274290",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.northviamarketing.anwarz",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.USE_FULL_SCREEN_INTENT"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Anwarz attaches the photos you pick to the chat.",
          "cameraPermission": "Anwarz uses the camera to take a picture for the chat.",
          "microphonePermission": "Anwarz uses the microphone for voice notes and the Speak button."
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#274290",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-audio",
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "image/*",
              "text/plain",
              "application/pdf"
            ],
            "multipleShareMimeTypes": [
              "image/*",
              "application/pdf"
            ]
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#274290",
          "defaultChannel": "info",
          "sounds": [
            "./assets/sounds/siren.wav",
            "./assets/sounds/chime.wav",
            "./assets/sounds/ding.wav",
            "./assets/sounds/alert.wav",
            "./assets/sounds/coins.wav",
            "./assets/sounds/knock.wav",
            "./assets/sounds/drop.wav"
          ]
        }
      ],
      [
        "react-native-fbsdk-next",
        {
          "appID": "1663830358491435",
          "clientToken": "5e884e26c64e0707948ab2c5cb1555bb",
          "displayName": "Anwarz",
          "scheme": "fb1663830358491435",
          "advertiserIDCollectionEnabled": false,
          "autoLogAppEventsEnabled": false,
          "isAutoInitEnabled": true
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "https://www.northviamarketing.com",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4bfec8f3-e7f0-4ba4-8e29-28e634ca7451"
      },
      "nativeSignIn": {
        "googleWebClientId": "637160083379-t7bq7fd6g7sb67hq8j43p3b4vosv3j7d.apps.googleusercontent.com"
      }
    },
    "owner": "ahmedahmedanwar",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/4bfec8f3-e7f0-4ba4-8e29-28e634ca7451",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
